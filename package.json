{
  "name": "quiq",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Quiq: hệ thống thi trắc nghiệm trực tuyến nhiều trường",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @quiq/api --filter @quiq/web dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint apps packages",
    "test": "vitest run",
    "build": "pnpm -r --if-present build",
    "format": "prettier --write apps packages"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
